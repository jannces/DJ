*.log
.DS_Store
.env
.env.backup
# setup-https.bat writes .env.backup-20260915-134702 every time it runs, and
# the bare `.env.backup` above does not match a timestamped name. Twenty-five
# of them had collected in one project root -- each a full copy of .env, with
# the database password, APP_KEY and mail credentials in it, untracked but NOT
# ignored, one `git add -A` away from being published.
.env.backup-*
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
# The TLS private key. Generated per install by deploy/make-cert.*, never shared.
/deploy/certs/
# Generated per install by deploy/setup-https.bat: it holds THIS machine's
# project path and subnet, so it is local truth rather than shared config.
/deploy/apache-vhost.local.conf
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
/database/database.sqlite

# Claude Code: project settings are shared; the .local file is per-machine.
/.claude/settings.local.json
