APP_NAME="LGU Alicia LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.alicia.local

APP_LOCALE=en
APP_TIMEZONE=Asia/Manila

# --- Database (XAMPP MySQL/MariaDB) -----------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_alicia
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions, cache, queue -------------------------------------------------
# database drivers work out-of-the-box on XAMPP (no Redis needed).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# To use Redis instead (optional, faster):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- Mail (for OTP + notifications) -----------------------------------------
# "log" writes the OTP to storage/logs/laravel.log instead of sending it — fine
# for the very first setup, but switch to a real transport below so codes reach
# the account's actual inbox. Verify with: php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@alicia.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail (needs 2-Step Verification + a 16-character App Password, not the
# account password). MAIL_FROM_ADDRESS must be the same Gmail account.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=youraccount@gmail.com
# MAIL_PASSWORD="abcd efgh ijkl mnop"
# MAIL_FROM_ADDRESS="youraccount@gmail.com"

# LGU / LAN mail server (no internet needed)
# MAIL_MAILER=smtp
# MAIL_HOST=mail.alicia.gov.ph
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=no-reply@alicia.gov.ph
# MAIL_PASSWORD=your-mailbox-password

# OTP mail is sent inline so it works without a queue worker. Set this to true
# only where "php artisan queue:work" runs continuously.
MAIL_QUEUE_OTP=false

# --- Seed super admin password (used once by CoreUserSeeder) ----------------
SEED_SUPERADMIN_PASSWORD="ChangeMe!Alicia2026"
